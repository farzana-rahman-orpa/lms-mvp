    "db:seed": "node --loader ts-node/register prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "jose": "^5.2.3",
    "js-cookie": "^3.0.5",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true
  }
