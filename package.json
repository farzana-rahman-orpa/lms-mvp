{
  "name": "lms-mvp",
  "version": "1.0.0",
  "private": true,
  "prisma": {
    "seed": "npm run db:seed"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && prisma db push && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
